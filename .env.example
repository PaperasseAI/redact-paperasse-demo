# Copy to .env for local dev. In production these are set on the host
# (pm2 env / systemd) — deploy.sh only verifies .env exists, it never ships
# secrets. There are no secrets here today, but the file exists so the
# pattern matches paperasse.ai-poc/apps/backend's convention and is ready
# for whichever env var needs one later.

# Port the server listens on.
PORT=8790

# Max upload size in bytes.
MAX_UPLOAD_BYTES=10485760

# Per-IP requests allowed per rolling minute.
RATE_LIMIT_PER_MIN=10

# Max redactions processed at once — protects the host from a burst of
# uploads spiking CPU/memory all at once.
MAX_CONCURRENT_REDACTIONS=2

# Where the redaction counter (stats.json) is stored. Defaults to ./data
# relative to the working directory. Set it to an absolute path to pin it.
# DATA_DIR=/home/ubuntu/redact-paperasse-demo/data
